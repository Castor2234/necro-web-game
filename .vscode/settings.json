{
  

  // Set Prettier as the default formatter for all files
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Enable format-on-save using Prettier
  "editor.formatOnSave": true,

  // Tell ESLint to auto-fix code quality issues on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Prevent VS Code's built-in JS/TS formatter from conflicting
  "js/ts.format.enabled": false,
  "js/ts.tsdk.path": "./node_modules/typescript/lib"
}

